{
  "compilerOptions": {
    "declaration": false,
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "paths": {
      "@src/*": ["./src/*"],
    },
    "resolveJsonModule": true,
    "rootDir": "./",
    "sourceMap": true,
    "sourceRoot": "/",
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "types": ["node"],
  },
  "exclude": [
    "node_modules/**/*",
    "lib/**/*",
    "src/**/*.test.ts",
    "__tests__/**/*",
  ],
  "include": ["./src/**/*"],
}
