{
  "compilerOptions": {
    "jsx": "react",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "resolveJsonModule": true,
    "rootDir": "./",
    "skipLibCheck": true,
    "sourceMap": true,
    "sourceRoot": "/",
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2022"
  },
  "exclude": ["node_modules/**/*", "lib/**/*"],
  "include": ["./src/**/*"]
}
